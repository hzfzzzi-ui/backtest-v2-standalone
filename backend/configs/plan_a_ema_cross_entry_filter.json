{
  "db": {
    "host": "pams-postgres",
    "port": 5432,
    "dbname": "pams",
    "user": "pams",
    "password": ""
  },
  "db_runtime": {
    "statement_timeout_ms": 60000
  },
  "universe": {
    "symbols": [],
    "benchmark": "000300.SH",
    "start": "2020-01-01",
    "end": "2024-12-31"
  },
  "data_source": {
    "stocks_table": "pams_ohlcv_daily",
    "index_table": "pit_index_daily",
    "prefer_index_table": true,
    "allow_cn_index_in_stocks_table": false,
    "cn_index_filter_column": "market",
    "cn_index_filter_value": "CN_INDEX"
  },
  "schema_mapping": {
    "pams_ohlcv_daily": {
      "date": "trade_date",
      "symbol": "symbol",
      "open": "open",
      "high": "high",
      "low": "low",
      "close": "close",
      "volume": "volume",
      "amount": "turnover",
      "limit_up": "limit_up",
      "limit_down": "limit_down",
      "is_suspended": "is_suspended",
      "adj_factor": "adj_factor"
    },
    "pit_index_daily": {
      "date": "trade_date",
      "symbol": "index_code",
      "open": "open",
      "high": "high",
      "low": "low",
      "close": "close",
      "volume": "volume",
      "amount": "amount"
    }
  },
  "data_scope": {
    "extend_prev_close": true,
    "prev_close_missing_policy": "disable_limit_check"
  },
  "execution": {
    "lot_size": 100,
    "tick_size": 0.01,
    "limit_pct_default": 0.1,
    "limit_pct_star": 0.05,
    "limit_pct_kcb_gem": 0.2,
    "liquidity_cap_pct": 0.1,
    "allow_liquidity_without_volume": false,
    "t_plus_one": true,
    "t_plus_one_cash": false,
    "limit_price_epsilon_mode": "tick_or_default",
    "limit_price_epsilon_default": 0.01
  },
  "costs": {
    "commission_rate": 0.0003,
    "commission_min": 5.0,
    "stamp_tax_rate": 0.001,
    "slippage_bps": 2.0,
    "slippage_mode": "price_adjustment_only"
  },
  "sizing": {
    "order_value": 30000,
    "lot_size": 100
  },
  "initial_capital": 100000,
  "strategy": {
    "name": "ema_cross",
    "fast": 8,
    "slow": 55,
    "order_size": 1000,
    "enable_atr_stop": true,
    "atr_stop_k": 2.0,
    "enable_atr_trail": true,
    "atr_trail_k": 3.0,
    "params": {
      "enable_entry_above_slow_ma": true,
      "enable_entry_slow_ma_slope": true,
      "entry_slope_lookback": 5
    }
  }
}
